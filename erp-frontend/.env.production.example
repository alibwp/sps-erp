# SPS ERP frontend - LIVE / PRODUCTION template
#
# Copy to .env.production and replace the placeholder with the public URL of
# your live backend (ends in /api). `npm run build` reads it automatically.
# It is baked in at build time: rebuild and redeploy after changing it.
# On Vercel / Netlify / Amplify, set the same variable in the project's
# environment settings instead.
NEXT_PUBLIC_API_URL=https://api.your-domain.com/api
