# SPS ERP frontend - environment variables
#
# Next.js picks the right file automatically:
#   .env.development -> `npm run dev`
#   .env.production  -> `npm run build` / `npm start` (the live site)
# Inside `docker compose up` the value comes from ../docker-compose.yml.

# URL the browser uses to reach the backend API (ends in /api, no trailing slash).
# NEXT_PUBLIC_ values are baked into the JavaScript at build time, so rebuild
# the frontend after changing it.
NEXT_PUBLIC_API_URL=http://localhost:5000/api
