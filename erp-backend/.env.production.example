# SPS ERP backend - LIVE / PRODUCTION template
#
# Copy to .env.production on the live server and fill in the placeholders.
# The backend reads it automatically when NODE_ENV=production.
# On a hosting platform, or with the Docker image, set the same KEY=value
# pairs as environment variables instead (docker run --env-file .env.production).
# Never commit the filled-in copy: it contains your live database password.

NODE_ENV=production
PORT=5000

# Connection string from your database provider:
#   postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# URL-encode special characters in the password (@ -> %40, # -> %23, / -> %2F).
# If the provider's URL ends in ?sslmode=require, remove that part; DB_SSL controls SSL.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# Cloud databases require SSL.
DB_SSL=true
# Keep true so the database certificate is verified.
# AWS RDS: the backend Docker image already trusts the RDS certificate bundle
#   (committed at certs/rds-global-bundle.pem). Outside Docker, start Node with
#   NODE_EXTRA_CA_CERTS=certs/rds-global-bundle.pem
#   (a real environment variable; it does not work from this file).
# false turns certificate checking off. Last resort only.
DB_SSL_REJECT_UNAUTHORIZED=true

# WARNING: must stay false on the live database. When true, TypeORM alters
# tables to match the code. (The backend also refuses it for non-local hosts.)
DB_SYNCHRONIZE=false

# Your live frontend URL(s), comma-separated, no trailing slash.
CORS_ORIGIN=https://your-frontend-domain.com
