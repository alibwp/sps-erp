# For running the backend outside Docker: copy to .env.
# Docker Compose sets these values itself.

NODE_ENV=development
PORT=5000
APP_URL=http://localhost:5000
DATABASE_URL=postgresql://sps:sps_password@localhost:5433/sps_erp
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true
# Tables come from migrations. Keep false on the live database.
DB_SYNCHRONIZE=false
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000

# Sign-in. These are development values; production refuses them.
# JWT_SECRET: at least 32 characters. APP_KEY: 32 random bytes, base64
# (node -e "console.log('base64:'+require('crypto').randomBytes(32).toString('base64'))").
JWT_SECRET=local-development-jwt-secret-not-for-production
APP_KEY=base64:c3BzLWVycC1sb2NhbC1kZXYtYXBwLWtleS0wMDAwMDA=
# The frontend's address, for links in emails. Required in production.
FRONTEND_URL=http://localhost:3000
ACCOUNT_INVITATION_EXPIRY_HOURS=72
# Refuse new email addresses whose domain has no mail (DNS) records.
CHECK_EMAIL_DOMAINS=true
# Number of proxies (load balancer) in front of the backend; 0 = none.
TRUST_PROXY=0
LOG_LEVEL=info
# API reference at /api/docs; off in production unless set to true.
# OPENAPI_ENABLED=true

# Redis for background jobs (rediss:// for TLS).
# Needs Redis running on this machine: Docker Compose keeps its Redis
# internal and publishes no Redis port.
REDIS_URL=redis://localhost:6379

# Outgoing email.
# Needs an SMTP server on this machine: Docker Compose publishes only
# Mailpit's web page (8025), not its SMTP port.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=
MAIL_FROM=SPS ERP <no-reply@sps-erp.test>

# File storage: local or s3
STORAGE_DRIVER=local
STORAGE_LOCAL_ROOT=storage
STORAGE_SIGNING_SECRET=local-development-signing-secret
# For STORAGE_DRIVER=s3 (use your project's selected AWS Region):
# S3_BUCKET=
# AWS_REGION=
