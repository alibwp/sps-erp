# SPS ERP backend - local environment variables
#
# Copy to .env for running the backend on your machine (npm run start:dev).
# For the live server use .env.production.example instead.
# Inside `docker compose up` these values come from ../docker-compose.yml.

NODE_ENV=development
PORT=5000

# PostgreSQL connection string: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# This one points at the Docker database (`docker compose up db` in the repo root).
DATABASE_URL=postgresql://sps:sps_password@localhost:5433/sps_erp

# true for cloud databases that require SSL (AWS RDS, Neon, Supabase, ...).
DB_SSL=false
# Keep true: it verifies the database's certificate.
DB_SSL_REJECT_UNAUTHORIZED=true

# Auto-create tables from entities. Only ever applied to a local database.
# WARNING: never set true while DATABASE_URL points at the live database.
DB_SYNCHRONIZE=true

# Frontend URL(s) allowed to call this API, comma-separated.
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000
